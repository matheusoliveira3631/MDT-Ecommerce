# Copie para .env.local (desenvolvimento) ou .env.production (servidor).

# Endereço público da loja (sitemap, Open Graph e dados estruturados)
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# Banco SQLite (o diretório é criado se não existir)
DATABASE_PATH=./data/loja.db

# Fotos no S3. Sem S3_BUCKET, as fotos ficam em UPLOADS_DIR (pasta local).
# No EC2, as credenciais vêm do papel IAM da instância: não coloque chaves aqui.
S3_BUCKET=
S3_REGION=sa-east-1
# Opcional: endereço público das fotos (CloudFront). Padrão: https://<bucket>.s3.<região>.amazonaws.com
S3_PUBLIC_URL=
UPLOADS_DIR=./data/uploads

# Integrações ainda simuladas (src/server/shipping.ts, coupons.ts, payments.ts).
# Sem valores de frete, o pedido não pode ser fechado: o servidor não cobra valor indefinido.
# Frete: serviço:centavos:dias úteis
FRETE_SIMULADO=
# Cupons: CODIGO:10% (percentual) ou CODIGO:500 (centavos)
CUPONS_SIMULADOS=
# Segredo do webhook de pagamento (HMAC-SHA256 do corpo no cabeçalho x-assinatura)
PAGAMENTO_WEBHOOK_SECRET=
